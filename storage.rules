rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Project documents
    match /projectDocuments/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Task attachments: allow authenticated users to upload files for tasks
    match /tasks/{projectId}/{taskId}/{fileName} {
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Allow write (create, update, delete) for authenticated users
      // Note: File size validation is done client-side (max 10MB)
      allow write: if request.auth != null;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
